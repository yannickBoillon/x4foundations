parameters:
    level: max
    # Le composer.lock impose PHP 8.4 (composer.json annonce encore >=8.2)
    phpVersion: 80400
    paths:
        - bin/
        - config/
        - public/
        - src/
        - migrations/
    excludePaths:
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
